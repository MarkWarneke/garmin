{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garmin-cadence",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  "ratelimits": [
    { "name": "RELAY_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "MCP_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
