{
  "name": "cadence-garmin-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Garmin dashboard and a private data connection for ChatGPT desktop and Codex",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i styles/app.css -o public/styles.css --minify",
    "dev:css": "tailwindcss -i styles/app.css -o public/styles.css --watch",
    "mcp": "node src/mcp.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/cli": "4.3.5",
    "tailwindcss": "4.3.5"
  }
}
